{
  "name": "trydim/abelohost",
  "description": "Blog on PHP",
  "minimum-stability": "stable",
  "license": "proprietary",
  "authors": [
    {
      "name": "TryDim",
      "email": "trydim85@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "smarty/smarty": "^5.8.4",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "Kernel\\": "kernel/"
    },
    "files": [
      "kernel/Helper/func.php"
    ]
  },
  "scripts": {
    "docker:upBuild": [
      "docker compose up --build -d"
    ],
    "docker:up": [
      "docker compose up -d"
    ],
    "docker:down": [
      "docker compose down"
    ],
    "docker:downFull": [
      "docker compose down -v"
    ]
  }
}
